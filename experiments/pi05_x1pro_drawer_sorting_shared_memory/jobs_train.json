{
  "jobs": [
    {
      "name": "full_state_seed42",
      "cwd": "policy/pi05",
      "cmd": [
        ".venv/bin/python",
        "scripts/train.py",
        "pi05_x1pro_drawer_sorting_full_state",
        "--exp-name=full_state_seed42",
        "--num-train-steps=30000",
        "--batch-size=32",
        "--seed=42"
      ],
      "env": {
        "PYTHONPATH": "src",
        "XLA_PYTHON_CLIENT_MEM_FRACTION": "0.95",
        "WANDB_RUN_GROUP": "pi05_x1pro_drawer_sorting_shared_memory",
        "WANDB_JOB_TYPE": "train"
      },
      "log_path": "policy/pi05/checkpoints/pi05_x1pro_drawer_sorting_full_state/_formal_logs/full_state_seed42/train.stdout.log",
